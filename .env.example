# RAG MCP Server Configuration

# FastMCP Configuration
MCP_SERVER_NAME=csv-rag-server
MCP_VERSION=1.0.0

# Transport Configuration
# Set to 'http' to enable HTTP transport, 'default' for stdio transport
TRANSPORT_MODE=default

# HTTP Transport Configuration (nested under http_transport)
# Use HTTP_TRANSPORT__ prefix for nested configuration
HTTP_TRANSPORT__ENABLE_HTTP_TRANSPORT=false
HTTP_TRANSPORT__HTTP_HOST=127.0.0.1
HTTP_TRANSPORT__HTTP_PORT=8080
HTTP_TRANSPORT__MAX_CONCURRENT_CONNECTIONS=100
HTTP_TRANSPORT__CONNECTION_TIMEOUT=300
HTTP_TRANSPORT__REQUEST_TIMEOUT=60
HTTP_TRANSPORT__ENABLE_CORS=true
HTTP_TRANSPORT__ENABLE_HEALTH_ENDPOINT=true
HTTP_TRANSPORT__HEALTH_CHECK_PATH=/health

# CSV Configuration
CSV_DATA_DIRECTORY=./data
CSV_DELIMITER=,
CSV_ENCODING=utf-8

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=csv_documents

# FastEmbed Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
ENABLE_SPARSE_EMBEDDINGS=false

# Processing Configuration
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONCURRENT_REQUESTS=10

# Monitoring Configuration
ENABLE_LOGFIRE=true
LOG_LEVEL=INFO